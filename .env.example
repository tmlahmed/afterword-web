DATABASE_URL=postgres://localhost:5432/afterword
PAYLOAD_SECRET=replace-with-a-long-random-string
MEILI_URL=http://127.0.0.1:7700
MEILI_KEY=replace-with-a-long-random-string

# Set when the accounts exist (see README)
# SSLCZ_STORE_ID=
# SSLCZ_STORE_PASSWORD=
# SSLCZ_LIVE=false

# bKash Tokenized Checkout (direct bKash payments). Uses the sandbox unless BKASH_LIVE=true.
# BKASH_APP_KEY=
# BKASH_APP_SECRET=
# BKASH_USERNAME=
# BKASH_PASSWORD=
# BKASH_LIVE=false
# NEXT_PUBLIC_SITE_URL=https://example.com

# Folder for uploaded images (covers, article pictures). Defaults to ./media
# MEDIA_DIR=

# Search engines may index the site only when this is true. Leave false everywhere except the live shop.
ALLOW_INDEXING=false

# Staff password-reset email: Lark Mail's SMTP settings (or any SMTP service). Without these, emails go to the server log.
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=shop@your-domain

# Off-site copy of each backup (rclone remote name and bucket), used by scripts/backup.sh
# RCLONE_REMOTE=b2:afterword-backups

# Pathao courier (Merchant API). Without these, staff type Pathao tracking numbers by hand.
# For local testing use the test-server credentials shown on Pathao's Developer's API page.
# PATHAO_CLIENT_ID=
# PATHAO_CLIENT_SECRET=
# PATHAO_USERNAME=          # your Pathao merchant login email
# PATHAO_PASSWORD=
# PATHAO_STORE_ID=          # pickup store; leave empty to use the account's default store
# PATHAO_LIVE=false         # true on the live server
# PATHAO_BASE_URL=          # only if Pathao gives a different live API address
# PATHAO_WEBHOOK_SECRET=    # the webhook secret you set in the Pathao panel
# PATHAO_WEBHOOK_REPLY=     # the integration secret Pathao asks the webhook to return
